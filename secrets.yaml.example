# 复制为 secrets.yaml 后填写真实值（secrets.yaml 已被 .gitignore 忽略）

# ---- WiFi ----
wifi_ssid: "YourWiFiSSID"
wifi_password: "YourWiFiPassword"

# ---- 静态 IP（强烈建议固定：DHCP 换址会让 HA 的 ESPHome 集成指向旧地址而"失联"）----
device_ip: "192.168.1.50"
gateway_ip: "192.168.1.1"

# ---- MQTT broker（App 也连这个）----
mqtt_broker: "192.168.1.10"
mqtt_username: "mqttuser"
mqtt_password: "mqttpassword"

# ---- Home Assistant 原生 API 加密密钥（32 字节 base64）----
# 生成： python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
fan_api_key: "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="
